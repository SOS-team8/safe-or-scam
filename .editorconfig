root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Java
[*.java]
indent_size = 4

# Python
[*.py]
indent_size = 4

# JavaScript / TypeScript / React
[*.{js,ts,jsx,tsx}]
indent_size = 2

# JSON / YAML
[*.{json,yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false