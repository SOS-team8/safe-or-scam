# PostgreSQL
POSTGRES_DB=sos_db
POSTGRES_USER=sos_user
POSTGRES_PASSWORD=localpass123

# MongoDB
MONGO_USERNAME=sos_user
MONGO_PASSWORD=localpass123
MONGO_DB=sos_db

# RabbitMQ
RABBITMQ_USER=sos_user
RABBITMQ_PASSWORD=localpass123

# JWT / verification — 로컬 개발용 더미 값. game-engine/.env 의 JWT_SECRET 과 동일해야 함.
JWT_SECRET=local-jwt-secret-key-at-least-32-bytes-123
VERIFICATION_TOKEN_SECRET=local-verification-token-secret-at-least-32-bytes-123

# 서버 간(game-engine >> backend) 내부 호출 인증용 공유 시크릿. 양쪽이 동일해야 함.
INTERNAL_API_KEY=local-internal-api-key-at-least-16-bytes
