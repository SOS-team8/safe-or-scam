# Google AI Studio (Gemini API) - 텍스트 LLM 호출용
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM 모델 (LiteLLM 형식, gemini/ 프리픽스 필수)
LLM_MODEL=gemini/gemini-3.1-flash-lite
IMAGE_MODEL=imagen-4.0-fast-generate-001

# Google Cloud Vertex AI (Imagen 이미지 생성용)
# 1. Google Cloud Console에서 Vertex AI API 활성화
# 2. 서비스 계정 생성 후 JSON 키 다운로드
# 3. JSON 파일을 apps/ai-pipeline/credentials/ 폴더에 복사
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=us-central1

# 서버 설정
BACKEND_PORT=8001
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 프로덕션 여부
IS_PRODUCTION=false

# 관리자 인증 (임시 - 추후 backend-spring으로 이관)
ADMIN_PASSWORD=change_me

# MongoDB (game-engine과 공유; news-article / scenario-tree contract)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=safe_or_scam

# 파이프라인 설정
MAX_DEPTH=5
MAX_CHOICES=3
SEMAPHORE_LIMIT=5
RETRY_COUNT=2
LLM_TIMEOUT=60
PIPELINE_TIMEOUT=3000

# 이미지 생성 설정
IMAGE_MAX_CONCURRENT=5
IMAGE_RETRY_COUNT=2
IMAGE_RETRY_DELAY=2.0
IMAGE_BATCH_SIZE=10
IMAGE_BATCH_WAIT=12.0

# 동시 작업 제한
MAX_CONCURRENT_TASKS=1

# 시나리오 이미지 정적 서빙 경로 (StaticFiles로 /api/v1/images에 마운트)
# 디렉토리가 존재할 때만 마운트되며, 미지정 시 기본값은 ~/workspace/data/images.
IMAGES_DIR=/Users/chris40461/workspace/data/images
