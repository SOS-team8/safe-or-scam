# OpenAI API — 텍스트 LLM + 이미지 생성 + 임베딩
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI models
LLM_MODEL=gpt-5.4-mini
# 비용 절감용 기본값. 최종 고품질 이미지가 필요하면 gpt-image-2 등으로 교체.
IMAGE_MODEL=gpt-image-1-mini
EMBEDDING_MODEL=text-embedding-3-small

# GCS bucket — publish_scenario.sh 가 시나리오 이미지를 올리는 곳 (#53).
# bucket 은 public read + CORS (Vercel/localhost) 설정 필요.
GCS_BUCKET=

# 서버 설정
BACKEND_PORT=8001
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'

# 프로덕션 여부
IS_PRODUCTION=false

# 관리자 인증 (임시 — 추후 backend-spring 으로 이관)
ADMIN_PASSWORD=change_me

# MongoDB (game-engine 과 공유; news-article / scenario-tree contract)
MONGODB_URL=mongodb://sos_user:localpass123@localhost:27017/?authSource=admin
MONGODB_DB=sos_db

# 파이프라인 설정
MAX_DEPTH=5
MAX_CHOICES=3
SEMAPHORE_LIMIT=5
RETRY_COUNT=2
LLM_TIMEOUT=60
# 큰 시나리오 트리 + 전체 이미지 생성까지 포함하므로 짧게 잡으면 timeout 가능.
PIPELINE_TIMEOUT=12000

# 이미지 생성 설정 (OpenAI Image API)
IMAGE_MAX_CONCURRENT=5
IMAGE_RETRY_COUNT=2
IMAGE_RETRY_DELAY=2.0
IMAGE_BATCH_SIZE=10
IMAGE_BATCH_WAIT=12.0

# 동시 작업 제한
MAX_CONCURRENT_TASKS=1

# ending_classifier 활성화 여부 — true 면 시나리오 생성 후 ending 노드를
# embedding 기반 클러스터링 (LLM 비용 발생). false 면 no-op.
ENABLE_ENDING_CLASSIFIER=true

# 시나리오 이미지 정적 서빙 경로 (#51, #53).
# 미설정 시 config 기본값 apps/ai-pipeline/app/data/images 사용. 이미지는 GCS 에
# publish 되므로 dev 외에는 보통 손댈 필요 없다.
# IMAGES_DIR=
