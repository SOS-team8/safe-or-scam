# Google AI Studio (Gemini API) — 텍스트 LLM + 이미지 생성 모두 사용
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM 모델 (LiteLLM 형식, gemini/ 프리픽스 필수)
LLM_MODEL=gemini/gemini-3.1-flash-lite

# 이미지 생성 모델 — Nano Banana 2 (Gemini 3.1 Flash Image Preview, #53).
# Imagen 4 family 는 2026-06 EOL 예정이라 forward path.
IMAGE_MODEL=gemini-3.1-flash-image-preview

# Google Cloud (GCS 이미지 호스팅 + 향후 Vertex AI 사용 시)
# 인증: ADC 권장 (`gcloud auth application-default login`).
# 본인 계정에 roles/storage.objectAdmin (publish_scenario.sh 용) 부여 필요.
# 조직 정책 iam.disableServiceAccountKeyCreation 으로 SA 키 발급이 차단된
# 환경에서는 ADC 만 사용 — GOOGLE_APPLICATION_CREDENTIALS 는 빈 값으로 둠.
# GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=us-central1

# GCS bucket — publish_scenario.sh 가 시나리오 이미지를 올리는 곳 (#53).
# bucket 은 public read + CORS (Vercel/localhost) 설정 필요.
GCS_BUCKET=your_gcs_bucket_name

# 서버 설정
BACKEND_PORT=8001
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 프로덕션 여부
IS_PRODUCTION=false

# 관리자 인증 (임시 — 추후 backend-spring 으로 이관)
ADMIN_PASSWORD=change_me

# MongoDB (game-engine 과 공유; news-article / scenario-tree contract)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=safe_or_scam

# 파이프라인 설정
MAX_DEPTH=5
MAX_CHOICES=3
SEMAPHORE_LIMIT=5
RETRY_COUNT=2
LLM_TIMEOUT=60
PIPELINE_TIMEOUT=3000

# 이미지 생성 설정 (Nano Banana 2 — IPM 은 AI Studio dashboard 에서 프로젝트별 확인)
IMAGE_MAX_CONCURRENT=5
IMAGE_RETRY_COUNT=2
IMAGE_RETRY_DELAY=2.0
IMAGE_BATCH_SIZE=10
IMAGE_BATCH_WAIT=12.0

# 동시 작업 제한
MAX_CONCURRENT_TASKS=1

# ending_classifier 활성화 여부 — true 면 시나리오 생성 후 ending 노드를
# embedding 기반 클러스터링 (LLM 비용 발생). false 면 no-op.
ENABLE_ENDING_CLASSIFIER=true

# 시나리오 이미지 정적 서빙 경로 (#51, #53).
# 미설정 시 config 기본값 apps/ai-pipeline/app/data/images 사용. 이미지는 GCS 에
# publish 되므로 dev 외에는 보통 손댈 필요 없다.
# IMAGES_DIR=
